# tsuki-pump-bot — .env template
# Copy to .env, set values, then `chmod 600 .env` on Linux/macOS or
# `icacls .env /inheritance:r /grant:r "$($env:USERNAME):(R)"` on Windows.

# ── Runtime mode ──────────────────────────────────────────────────────────
# paper-mock = no real chain RPC needed; uses recorded firehose for replay
# paper      = real Solana RPC for market data, mock fills (DEFAULT)
# devnet     = real devnet, fake SOL (requires --i-understand-this-trades-real-money)
# mainnet    = real mainnet, REAL SOL (requires --i-understand-this-trades-real-money)
TSUKI_PUMP_MODE=paper

# Path to YAML config
TSUKI_PUMP_CONFIG=config.yaml

# Where SQLite + JSONL audit log + rotating .log live
TSUKI_PUMP_STATE_DIR=./state

# Log level: DEBUG | INFO | WARNING | ERROR
TSUKI_PUMP_LOG_LEVEL=INFO

# ── Solana RPC ────────────────────────────────────────────────────────────
# Public mainnet RPC is rate-limited and slow. Get a free Helius key at
# https://www.helius.dev/ — paid tiers ($50-200/mo) unlock low-latency
# Yellowstone gRPC streams. Don't pay for this until paper mode shows edge.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_DEVNET_RPC_URL=https://api.devnet.solana.com

# Optional: Yellowstone gRPC endpoint (Helius / Triton / Shyft / self-hosted).
# Leave blank to fall back to HTTP polling at the cost of higher latency.
SOLANA_GRPC_URL=
SOLANA_GRPC_TOKEN=

# ── Wallet keys (ONLY needed for devnet / mainnet modes) ──────────────────
# 3-tier model: keep COLD on hardware wallet, WARM encrypted offline,
# HOT here is the trading-only key with hard caps in config.yaml.
# Format: base58 secret key string OR JSON array of 64 ints from
# `solana-keygen new --outfile keypair.json`.
SOLANA_HOT_WALLET_SECRET=

# ── Telegram (optional but strongly recommended) ──────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Optional integrations ─────────────────────────────────────────────────
# Cielo / Birdeye / DexScreener API keys — only used for filter enrichment.
# All filters degrade gracefully when these are missing.
BIRDEYE_API_KEY=
DEXSCREENER_API_KEY=
